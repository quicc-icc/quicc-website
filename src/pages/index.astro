---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import publicationsData from '../data/publications.json';
import { url } from '../utils/paths';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const publications = [...publicationsData]
	.sort((a, b) => (b.year || 0) - (a.year || 0))
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<style>
			.hero {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 1rem 0 2rem;
			}

			.hero-logo {
				height: 200px;
				width: auto;
				margin-bottom: 2rem;
				border-radius: 0;
				box-shadow: none;
			}

			.hero-title {
				font-size: 4.5rem;
				line-height: 1;
				margin-bottom: 1.25rem;
			}

			.hero-subtitle,
			.hero-place {
				font-family: var(--font-sans);
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--color-text-muted);
				margin: 0;
			}

			.hero-subtitle {
				font-size: 1.1rem;
				margin-bottom: 0.5rem;
			}

			.hero-place {
				font-size: 0.85rem;
			}

			.hero-intro {
				font-size: 1.05rem;
				line-height: 1.7;
				max-width: 40rem;
				margin: 2.5rem auto 2rem;
			}

			.pub-mini-item {
				margin-bottom: 1.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--color-border);
			}

			.pub-mini-item:last-child {
				border-bottom: none;
				margin-bottom: 0;
			}

			.pub-title {
				font-weight: 700;
				color: var(--color-text-main);
				display: block;
				margin-bottom: 0.25rem;
				font-family: var(--font-serif);
				font-size: 1.1rem;
			}

			.pub-meta {
				font-size: 0.9rem;
				color: var(--color-text-muted);
				line-height: 1.5;
			}

			.hero-buttons {
				display: flex;
				justify-content: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.logo-dark {
				display: none;
			}

			html[data-theme="dark"] .logo-light {
				display: none;
			}

			html[data-theme="dark"] .logo-dark {
				display: block;
			}

			@media (max-width: 768px) {
				.hero {
					padding: 0 0 1rem;
				}

				.hero-logo {
					height: 140px;
					margin-bottom: 1.5rem;
				}

				.hero-title {
					font-size: 3.25rem;
				}

				.hero-subtitle {
					font-size: 0.95rem;
				}

				.hero-place span {
					display: block;
				}

				.hero-place .sep {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<img
					src={url('/quicc_lightt.png')}
					width="1393"
					height="1897"
					alt="QuICC logo"
					class="hero-logo logo-light"
					fetchpriority="high"
					decoding="async"
				/>

				<img
					src={url('/quicc_darkk.png')}
					width="1393"
					height="1899"
					alt="QuICC logo"
					class="hero-logo logo-dark"
					decoding="async"
				/>

				<h1 class="hero-title">QuICC</h1>

				<p class="hero-subtitle">
					Quantum Information, Computation and Communication
				</p>

				<p class="hero-place">
					<span>Instituto de Ciencias de la Computación</span><span class="sep"> — </span><span>UBA-CONICET</span>
				</p>

				<p class="hero-intro">
					We are a research group focused on 
					<strong> quantum information science, including quantum
						computation and quantum communication</strong>.
				</p>

				<div class="hero-buttons">
					<a href={url('/publications')} class="btn">
						View Publications
					</a>

					<a
						href={url('/projects')}
						class="btn btn-outline"
					>
						Current Projects
					</a>
				</div>
			</section>

			<hr
				style="
					margin: 3rem 0;
					border-top: 1px solid var(--color-border);
				"
			/>

			<div
				class="grid-2"
				style="gap: 4rem; margin-top: 0;"
			>
				<section>
					<h2 style="margin-top: 0;">
						Latest Publications
					</h2>

					<div class="publication-list">
						{publications.length > 0 ? (
							publications.map((pub) => (
								<div class="pub-mini-item">
									{pub.url ? (
										<a class="pub-title" href={pub.url} target="_blank" rel="noopener">{pub.title}</a>
									) : (
										<span class="pub-title">{pub.title}</span>
									)}

									<div class="pub-meta">
										{pub.authors?.join(', ')}

										<br />

										<span style="font-style: italic; color: var(--color-accent);">{pub.venue || 'Preprint'}</span>{pub.year ? `, ${pub.year}` : ''}
									</div>
								</div>
							))
						) : (
							<p>No publications found.</p>
						)}
					</div>

					<div style="margin-top: 1.5rem;">
						<a
							href={url('/publications')}
							style="font-weight: 600;"
						>
							View Full List &rarr;
						</a>
					</div>
				</section>

				<section>
					<h2 style="margin-top: 0;">News</h2>

					<ul style="list-style: none; padding: 0;">
						{posts.map((post) => (
							<li
								style="
									margin-bottom: 1.5rem;
									padding-bottom: 1.5rem;
									border-bottom: 1px dashed var(--color-border);
								"
							>
								<a
									href={url(`/blog/${post.id}/`)}
									style="
										display: block;
										font-family: var(--font-serif);
										font-size: 1.1rem;
										font-weight: 600;
										color: var(--color-text-main);
										margin-bottom: 0.25rem;
									"
								>
									{post.data.title}
								</a>

								<small
									style="
										color: var(--color-text-muted);
										text-transform: uppercase;
										font-size: 0.8rem;
									"
								>
									{post.data.pubDate.toLocaleDateString(
										'en-us',
										{
											year: 'numeric',
											month: 'short',
											day: 'numeric',
										}
									)}
								</small>
							</li>
						))}
					</ul>

					<a
						href={url('/blog')}
						style="font-weight: 600;"
					>
						View Blog &rarr;
					</a>
				</section>
			</div>
		</main>

		<Footer />
	</body>
</html>
