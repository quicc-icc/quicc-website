---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import authorsData from '../data/authors.json';
import { generateFallbackAvatar } from '../utils/avatar';
import { teamImages } from '../data/teamImages';

type AuthorRecord = (typeof authorsData)[number] & { affiliation?: string; program?: string };

// Secciones de la página, en orden. Cada categoría de authors.json va a una sola sección.
// card: 'large' = tarjeta grande con foto; 'small' = tarjeta chica en lista.
const SECTIONS = [
	{ category: 'researcher', title: 'Researchers', card: 'large' },
	{ category: 'phd', title: 'PhD Students', card: 'large' },
	{ category: 'masters', title: "Master's Students", card: 'large' },
	{ category: 'collaborator', title: 'Collaborators', card: 'small' },
	{ category: 'former', title: 'Former Members', card: 'small' },
] as const;

const teamAuthors = authorsData as AuthorRecord[];

// Una categoría mal escrita haría desaparecer a la persona de la página sin aviso:
// mejor que la compilación falle diciendo qué entrada es.
const validCategories: readonly string[] = SECTIONS.map((s) => s.category);
const invalid = teamAuthors.filter((m) => !validCategories.includes(m.category));
if (invalid.length > 0) {
	const list = invalid
		.map((m) => `  - "${m.name}" (id "${m.id}"): category "${m.category ?? ''}"`)
		.join('\n');
	throw new Error(
		`src/data/authors.json: categoría desconocida en ${invalid.length} entrada(s):\n${list}\n` +
			`Categorías válidas: ${validCategories.join(', ')}.`
	);
}

const withFallback = (member: AuthorRecord) => ({
	...member,
	avatarSrc: member.avatar
		? teamImages[member.avatar as keyof typeof teamImages]?.src
		: null,
	fallbackAvatar: generateFallbackAvatar(member.name),
});

// En las tarjetas chicas: la afiliación si existe; si no, el rol ("Former Member" no aporta nada).
const smallCardDetail = (member: AuthorRecord) =>
	member.affiliation?.trim() || (member.role === 'Former Member' ? '' : member.role);

const sections = SECTIONS.map((section) => ({
	...section,
	members: teamAuthors
		.filter((member) => member.category === section.category)
		.sort((a, b) => (a.sortOrder ?? 99) - (b.sortOrder ?? 99))
		.map(withFallback),
})).filter((section) => section.members.length > 0);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Team | ${SITE_TITLE}`}
			description="Research Team & Collaborators"
		/>

		<style>
			/* Títulos de sección discretos: texto chico + línea hasta el ancho del contenido */
			.section-title {
				display: flex;
				align-items: center;
				gap: 1rem;
				width: 100%;
				margin: 3rem 0 1.25rem;
				padding: 0;
				border: none;
				font-family: var(--font-sans);
				font-size: 0.95rem;
				font-weight: 600;
				letter-spacing: 0.02em;
				color: var(--color-text-muted);
			}

			.section-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background: var(--color-border);
			}

			/* Oculto a la vista, pero presente para lectores de pantalla y buscadores */
			.visually-hidden {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			main {
				padding-top: 2rem;
			}

			/* Cards */

			.team-card {
				text-align: center;
				padding: 1rem 0.75rem;
				border: 1px solid var(--color-border);
				border-radius: 6px;
				background-color: var(--color-bg-offset);
				transition: all 0.2s ease;
				cursor: pointer;
			}

			.team-card:hover {
				transform: translateY(-2px);
				box-shadow: var(--shadow-md);
				border-color: var(--color-accent);
			}

			/* Avatar */

			.team-avatar {
				width: 140px;
				height: auto;
				max-width: 100%;
				aspect-ratio: 1 / 1;
				border-radius: 50%;
				object-fit: cover;
				object-position: center top;
				display: block;
				margin: 0 auto 0.6rem auto;
			}

			.team-name {
				font-weight: 700;
				font-size: 1rem;
				line-height: 1.3;
				display: block;
				color: var(--color-text-main);
				margin-bottom: 0.15rem;
			}

			.team-role {
				display: block;
				margin: 0;
				font-size: 0.85rem;
				color: var(--color-accent);
			}

			.team-links {
				display: flex;
				justify-content: center;
				gap: 0.8rem;
				margin-top: 0.7rem;
			}

			.team-link {
				font-size: 0.9rem;
				color: var(--color-text-muted);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.team-link:hover {
				color: var(--color-accent);
			}

			/* Collaborators */

			.collab-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1rem;
				margin-top: 1.5rem;
			}

			.collab-card {
				display: flex;
				gap: 1rem;
				align-items: center;
				padding: 0.75rem 1rem;
				background-color: var(--color-bg-offset);
				border: 1px solid var(--color-border);
				border-radius: 6px;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.collab-card:hover {
				border-color: var(--color-accent);
				transform: translateY(-2px);
				box-shadow: var(--shadow-md);
			}

			.collab-card img {
				width: 48px;
				height: 48px;
				border-radius: 50%;
				object-fit: cover;
				flex-shrink: 0;
			}

			.collab-info .collab-name {
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--color-text-main);
				display: block;
			}

			.collab-info .collab-affil {
				display: block;
				font-size: 0.85rem;
				line-height: 1.35;
				margin-top: 0.15rem;
				color: var(--color-text-muted);
			}

			/* Escritorio: cinco tarjetas grandes por fila.
			   Va después de las reglas base para que las pise. */
			@media (min-width: 900px) {
				.team-grid {
					grid-template-columns: repeat(5, minmax(0, 1fr));
					gap: 1.25rem;
				}

				.team-card {
					padding: 0.9rem 0.6rem;
				}

				.team-avatar {
					width: 120px;
					height: 120px;
				}
			}

			/* Celular: tarjetas grandes en dos columnas, con foto más chica */
			@media (max-width: 600px) {
				.team-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 0.75rem;
					margin-top: 1rem;
				}

				.team-card {
					padding: 1rem 0.5rem;
				}

				.team-avatar {
					width: 96px;
					height: 96px;
				}

				.team-name {
					font-size: 0.95rem;
				}

				.team-role {
					font-size: 0.8rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<h1 class="visually-hidden">Team</h1>

			{sections.map((section) => (
				<section>
					<h2 class:list={['section-title', { 'visually-hidden': section.category === 'researcher' }]}>
						{section.title}
					</h2>

					{section.card === 'large' ? (
						<div class="grid-3 team-grid">
							{section.members.map((profile) => (
								<div
									class="team-card interactive-card author-modal-trigger"
									data-member={JSON.stringify(profile)}
								>
									<img
										src={profile.avatarSrc || profile.fallbackAvatar}
										alt={profile.name}
										class="team-avatar"
										onerror={`this.onerror=null;this.src='${profile.fallbackAvatar}'`}
									/>

									<span class="team-name">{profile.name}</span>

									{/* En las secciones de estudiantes el título ya dice el rol: se muestra la carrera */}
									<span class="team-role">{profile.program || profile.role}</span>
								</div>
							))}
						</div>
					) : (
						<div class="collab-grid">
							{section.members.map((profile) => {
								const detail = smallCardDetail(profile);
								return (
									<div
										class="collab-card author-modal-trigger"
										data-member={JSON.stringify(profile)}
									>
										<img
											src={profile.avatarSrc || profile.fallbackAvatar}
											alt={profile.name}
											onerror={`this.onerror=null;this.src='${profile.fallbackAvatar}'`}
										/>

										<div class="collab-info">
											<span class="collab-name">{profile.name}</span>
											{detail && <span class="collab-affil">{detail}</span>}
										</div>
									</div>
								);
							})}
						</div>
					)}
				</section>
			))}
		</main>

		<Footer />
	</body>
</html>
