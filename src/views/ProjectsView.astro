---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { field } from '../i18n/content';
import { langFromUrl, t } from '../i18n/ui';

import projects from '../data/projects.json';

const lang = langFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t(lang, 'projects.metaTitle')} | ${SITE_TITLE}`} description={t(lang, 'projects.description')} />
	</head>
	<body>
		<Header />

		<main>
			<h1>{t(lang, 'projects.title')}</h1>

			<p>
				{t(lang, 'projects.intro')}
			</p>

			{projects.map((section) => (
				<section class="project-section">
					<h2>{field(section, 'title', lang)}</h2>

					<div class="project-list">
						{section.items.map((item) => (
							<div class="project-item">
								<h3>{field(item, 'title', lang)}</h3>
								<p>{field(item, 'description', lang)}</p>
							</div>
						))}
					</div>
				</section>
			))}
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	h1 {
		margin-bottom: 1rem;
	}

	p {
		line-height: 1.35;
	}

	.project-section {
		margin-top: 3rem;
	}

	.project-section h2 {
		margin-bottom: 1.5rem;
	}

	.project-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.2rem;
	}

	.project-item {
		padding: 1rem 1.1rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background-color: var(--color-bg-offset);
		transition: all 0.2s ease;
	}

	.project-item:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		border-color: var(--color-accent);
	}

	.project-item p {
		margin-top: 0.25rem;
		margin-bottom: 0;
		color: var(--color-text-secondary);
		line-height: 1.35;
	}

	.project-item h3 {
		margin-bottom: 0.4rem;
		font-size: 1.2rem;
	}

	.project-item p {
		color: var(--color-text-secondary);
	}

	@media (max-width: 768px) {
		.project-list {
			grid-template-columns: 1fr;
		}
	}
</style>